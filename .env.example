# Адрес публикации OData без завершающего слеша.
ONEC_ODATA_URL=http://77.235.24.219:2026/Test/ru_RU/odata/standard.odata

# Сервисная учётная запись 1С. Не коммитьте реальные значения в Git.
ONEC_USER=odata.user
ONEC_PASSWORD=replace-with-real-password

# Необязательные настройки API.
PORT=4000
ONEC_TIMEOUT_MS=30000
ONEC_RETRIES=1
ONEC_PAGE_SIZE=25
ONEC_REPORT_CACHE_TTL_MS=120000

# Оставьте пустым при локальном запуске и через Cloudflare Tunnel:
# React будет обращаться к /api через прокси Vite.
# VITE_API_URL=
