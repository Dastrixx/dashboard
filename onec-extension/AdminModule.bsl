// Общий модуль дш_ДашбордАдминистрирование: служебные действия для администратора.
// Вызывается через внешнее соединение (COM) или из консоли кода.

#Область ПрограммныйИнтерфейс

// Создаёт или обновляет служебного пользователя HTTP-сервиса дашборда:
// элемент справочника «Пользователи» + пользователь ИБ с единственной ролью
// «дш_ЧтениеДанныхДашборда», аутентификация 1С:Предприятия по паролю.
//
// Параметры:
//   Имя    - Строка - имя пользователя, например "dashboard_api".
//   Пароль - Строка - пароль.
//
// Возвращаемое значение:
//   Строка - результат: "created", "updated" или текст ошибки.
//
Функция УстановитьПользователяДашборда(Имя, Пароль) Экспорт

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат "error: нужны права администратора";
	КонецЕсли;

	Попытка

		Роли = Новый Массив;
		Роли.Добавить("дш_ЧтениеДанныхДашборда");

		Описание = Новый Структура;
		Описание.Вставить("Действие", "Записать");
		Описание.Вставить("Имя", Имя);
		Описание.Вставить("Пароль", Пароль);
		Описание.Вставить("ВходВПрограммуРазрешен", Истина);
		Описание.Вставить("АутентификацияСтандартная", Истина);
		Описание.Вставить("АутентификацияОС", Ложь);
		Описание.Вставить("ПоказыватьВСпискеВыбора", Ложь);
		Описание.Вставить("Роли", Роли);

		Ссылка = Справочники.Пользователи.НайтиПоНаименованию(Имя, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Объект = Ссылка.ПолучитьОбъект();
			Результат = "updated";
		Иначе
			Объект = Справочники.Пользователи.СоздатьЭлемент();
			Объект.Наименование = Имя;
			Результат = "created";
		КонецЕсли;
		Объект.Комментарий = "Служебный пользователь HTTP-сервиса дашборда (только чтение)";
		Объект.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", Описание);
		Объект.Записать();
		
		// Роли в Рознице раздаются через профили и группы доступа (БСП):
		// профиль с единственной ролью расширения + группа с этим пользователем.
		ВключитьВГруппуДоступаДашборда(Объект.Ссылка);
		
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Имя);
		Если ПользовательИБ = Неопределено Тогда
			Возврат "error: пользователь ИБ не создан";
		КонецЕсли;

		ИменаРолей = Новый Массив;
		Для Каждого Роль Из ПользовательИБ.Роли Цикл
			ИменаРолей.Добавить(Роль.Имя);
		КонецЦикла;
		Возврат Результат + "; roles: " + СтрСоединить(ИменаРолей, ",");

	Исключение
		Возврат "error: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НаименованиеДоступаДашборда()
	Возврат "Дашборд: чтение данных (HTTP-сервис)";
КонецФункции

Процедура ВключитьВГруппуДоступаДашборда(Пользователь)
	
	Наименование = НаименованиеДоступаДашборда();
	
	Ссылка = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Профиль = Ссылка.ПолучитьОбъект();
	Иначе
		Профиль = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
		Профиль.Наименование = Наименование;
	КонецЕсли;
	Профиль.Комментарий = "Только чтение данных для дашборда аналитики продаж (расширение dashboard)";
	Профиль.Роли.Очистить();
	Профиль.Роли.Добавить().Роль = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Роль.дш_ЧтениеДанныхДашборда");
	Профиль.Назначение.Очистить();
	Профиль.Назначение.Добавить().ТипПользователей = Справочники.Пользователи.ПустаяСсылка();
	Профиль.Записать();
	
	Ссылка = Справочники.ГруппыДоступа.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Группа = Ссылка.ПолучитьОбъект();
	Иначе
		Группа = Справочники.ГруппыДоступа.СоздатьЭлемент();
		Группа.Наименование = Наименование;
	КонецЕсли;
	Группа.Профиль = Профиль.Ссылка;
	Если Группа.Пользователи.Найти(Пользователь, "Пользователь") = Неопределено Тогда
		Группа.Пользователи.Добавить().Пользователь = Пользователь;
	КонецЕсли;
	Группа.Записать();
	
	УправлениеДоступом.ОбновитьРолиПользователей(Пользователь);
	
КонецПроцедуры

#КонецОбласти
