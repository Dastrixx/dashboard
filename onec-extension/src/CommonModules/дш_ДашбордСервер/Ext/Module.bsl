// Ключ кэша: только параметры, влияющие на выборку (без limit и offset).
Функция КлючВыборки(Параметры)
	Части = Новый Массив;
	Для Каждого Имя Из СтрРазделить("from,to,date", ",") Цикл
		Значение = Параметры.Получить(Имя);
		Если ЗначениеЗаполнено(Значение) Тогда
			Части.Добавить(Имя + "=" + СокрЛП(Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");
КонецФункции

Функция ПараметрыИзСтроки(СтрокаПараметров)
	Параметры = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить(СтрокаПараметров, "&", Ложь) Цикл
		Позиция = СтрНайти(Пара, "=");
		Если Позиция > 0 Тогда
			Параметры.Вставить(Лев(Пара, Позиция - 1), Сред(Пара, Позиция + 1));
		КонецЕсли;
	КонецЦикла;
	Возврат Параметры;
