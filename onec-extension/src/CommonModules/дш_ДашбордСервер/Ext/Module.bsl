// Разбирает from/to (ГГГГ-ММ-ДД). Период не длиннее МаксДней дней.
Функция ПериодИзПараметров(Параметры, МаксДней)

	СтрокаС = Параметры.Получить("from");
	СтрокаПо = Параметры.Получить("to");
	Если Не ЗначениеЗаполнено(СтрокаС) Или Не ЗначениеЗаполнено(СтрокаПо) Тогда
		ОшибкаПараметра("Нужны параметры from и to в формате ГГГГ-ММ-ДД");
	КонецЕсли;

	Начало = НачалоДня(ДатаИзСтроки(СтрокаС, "from"));
	Конец = КонецДня(ДатаИзСтроки(СтрокаПо, "to"));

	Если Конец < Начало Тогда
		ОшибкаПараметра("Параметр to раньше from");
	КонецЕсли;
	Если (НачалоДня(Конец) - Начало) / 86400 + 1 > МаксДней Тогда
		ОшибкаПараметра(СтрШаблон("Период не должен превышать %1 дн.", МаксДней));
	КонецЕсли;

	Возврат Новый Структура("Начало, Конец", Начало, Конец);

КонецФункции

Функция ДатаИзСтроки(Строка, ИмяПараметра)

	Части = СтрРазделить(СокрЛП(Строка), "-");
	Если Части.Количество() <> 3 Или СтрДлина(Части[0]) <> 4 Тогда
		ОшибкаПараметра(СтрШаблон("Параметр %1: ожидается дата ГГГГ-ММ-ДД", ИмяПараметра));
	КонецЕсли;

	Попытка
		Результат = Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]));
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Если Результат = Неопределено Тогда
		ОшибкаПараметра(СтрШаблон("Параметр %1: некорректная дата %2", ИмяПараметра, Строка));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЧислоИзПараметра(Параметры, Имя, ПоУмолчанию, Минимум, Максимум)

	Значение = Параметры.Получить(Имя);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Попытка
		Результат = Число(Значение);
	Исключение
		Результат = -1;
	КонецПопытки;

	Если Результат <> Цел(Результат) Или Результат < Минимум Или Результат > Максимум Тогда
		ОшибкаПараметра(СтрШаблон("Параметр %1: ожидается целое число от %2 до %3", Имя, Минимум, Максимум));
	КонецЕсли;
	Возврат Результат;

КонецФункции

