// Общий модуль дш_ДашбордСервер: выгрузка данных для дашборда аналитики продаж.
// Вызывается из HTTP-сервиса дш_Дашборд (/hs/dashboard/v1/<ресурс>)
// и через внешнее соединение (для проверки без веб-сервера).
// Только чтение. Данные читаются с правами текущего пользователя
// (роль расширения «дш_ЧтениеДанныхДашборда»).

#Область ПрограммныйИнтерфейс

// Обрабатывает запрос к ресурсу.
//
// Параметры:
//   ИмяРесурса - Строка - sales, returns, checks, stock, receipts, writeoffs,
//                recounts, products, stores, sellers, suppliers, ping.
//   Параметры  - Соответствие, ФиксированноеСоответствие - параметры запроса
//                (from, to, date, limit, offset).
//
// Возвращаемое значение:
//   Структура - Код (Число, HTTP-код) и Тело (Строка, JSON).
//
Функция ОбработатьЗапрос(ИмяРесурса, Параметры) Экспорт

	Ресурс = НРег(СокрЛП(ИмяРесурса));

	Попытка

		Если Ресурс = "ping" Тогда
			Ответ = Новый Структура("status, version, time", "ok", "1.2.0", ФорматДатаВремя(ТекущаяДатаСеанса()));
			Возврат ОтветJSON(200, Ответ);
		ИначеЕсли РесурсыТаблиц().Найти(Ресурс) <> Неопределено Тогда
			// Результат запроса кэшируется на время сеанса в пределах 5-минутного
			// интервала: страницы offset/limit одной выгрузки берутся из кэша,
			// а не выполняют запрос к базе заново.
			Таблица = дш_ДашбордКэш.Выборка(Ресурс, КлючВыборки(Параметры), НомерИнтервалаКэша());
			Возврат ОтветТаблицей(Таблица, Параметры);
		Иначе
			Возврат ОтветОшибка(404, "Неизвестный ресурс: " + Ресурс);
		КонецЕсли;

	Исключение

		Инфо = ИнформацияОбОшибке();
		Текст = Инфо.Описание;
		Если СтрНачинаетсяС(Текст, ПрефиксОшибкиПараметра()) Тогда
			Возврат ОтветОшибка(400, Сред(Текст, СтрДлина(ПрефиксОшибкиПараметра()) + 1));
		КонецЕсли;

		ЗаписьЖурналаРегистрации("Дашборд.Выгрузка", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ресурс: " + Ресурс + Символы.ПС + ПодробноеПредставлениеОшибки(Инфо));
		Возврат ОтветОшибка(500, "Внутренняя ошибка сервиса 1С. Подробности — в журнале регистрации, событие ""Дашборд.Выгрузка"".");

	КонецПопытки;

КонецФункции

// Для проверки через внешнее соединение (COM) без веб-сервера.
// СтрокаПараметров — как в URL: "from=2026-10-01&to=2026-10-31&limit=10".
// Возвращает строку: HTTP-код, перевод строки, тело JSON.
Функция ПроверочныйЗапрос(ИмяРесурса, СтрокаПараметров = "") Экспорт
	
	Результат = ОбработатьЗапрос(ИмяРесурса, ПараметрыИзСтроки(СтрокаПараметров));
	Возврат Формат(Результат.Код, "ЧГ=0") + Символы.ПС + Результат.Тело;
	
КонецФункции

// Выполняет выборку ресурса. Вызывается из модуля дш_ДашбордКэш
// (повторное использование на время сеанса).
//
// Параметры:
//   Ресурс         - Строка - имя ресурса из РесурсыТаблиц().
//   КлючПараметров - Строка - from/to/date в виде "from=...&to=...&date=...".
//
// Возвращаемое значение:
//   ТаблицаЗначений
//
Функция Выборка(Ресурс, КлючПараметров) Экспорт

	Параметры = ПараметрыИзСтроки(КлючПараметров);
	Если Ресурс = "sales" Тогда
		Возврат Продажи(Параметры, Ложь);
	ИначеЕсли Ресурс = "returns" Тогда
		Возврат Продажи(Параметры, Истина);
	ИначеЕсли Ресурс = "checks" Тогда
		Возврат Чеки(Параметры);
	ИначеЕсли Ресурс = "stock" Тогда
		Возврат Остатки(Параметры);
	ИначеЕсли Ресурс = "receipts" Тогда
		Возврат Поступления(Параметры);
	ИначеЕсли Ресурс = "writeoffs" Тогда
		Возврат Списания(Параметры);
	ИначеЕсли Ресурс = "recounts" Тогда
		Возврат Пересчеты(Параметры);
	ИначеЕсли Ресурс = "products" Тогда
		Возврат Номенклатура();
	ИначеЕсли Ресурс = "stores" Тогда
		Возврат МагазиныИСклады();
	ИначеЕсли Ресурс = "sellers" Тогда
		Возврат Продавцы();
	ИначеЕсли Ресурс = "suppliers" Тогда
		Возврат Поставщики();
	КонецЕсли;
	ВызватьИсключение "Неизвестный ресурс: " + Ресурс;

КонецФункции

#КонецОбласти

#Область Данные

// Продажи (Возвраты = Ложь) или возвраты (Возвраты = Истина),
// сгруппированные по дню, магазину, складу, товару и продавцу.
//
// Продажи — из регистра «Продажи», как в отчётах 1С и OData: количество,
// сумма, скидка (СтоимостьБезСкидок − Стоимость) и себестоимость совпадают
// с отчётами о розничных продажах. Регистр уже за вычетом возвратов
// (возврат в той же смене зачитывается, в другой — пишется с минусом),
// поэтому строки могут быть отрицательными, а вычитать returns из sales
// не нужно.
//
// Возвраты — из строк чеков возврата ККМ (сколько и на какую сумму
// вернули на кассе), для аналитики возвратов.
Функция Продажи(Параметры, Возвраты)

	Период = ПериодИзПараметров(Параметры, 31);
	Если Возвраты Тогда
		Возврат ВозвратыПоЧекам(Период);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(П.Период, ДЕНЬ) КАК date,
	|	П.Магазин КАК store_guid,
	|	П.Магазин.Код КАК store_code,
	|	П.Склад КАК warehouse_guid,
	|	П.Номенклатура КАК product_guid,
	|	П.Номенклатура.Код КАК product_code,
	|	П.Продавец КАК seller_guid,
	|	П.Продавец.Наименование КАК seller_name,
	|	ВЫБОР
	|		КОГДА П.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК online,
	|	СУММА(П.Количество) КАК qty,
	|	СУММА(П.Стоимость) КАК sum,
	|	СУММА(П.СтоимостьБезСкидок - П.Стоимость) КАК discount,
	|	СУММА(П.ор_Себестоимость) КАК cost
	|ИЗ
	|	РегистрНакопления.Продажи КАК П
	|ГДЕ
	|	П.Период МЕЖДУ &Начало И &Конец
	|	И П.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(П.Период, ДЕНЬ),
	|	П.Магазин,
	|	П.Магазин.Код,
	|	П.Склад,
	|	П.Номенклатура,
	|	П.Номенклатура.Код,
	|	П.Продавец,
	|	П.Продавец.Наименование,
	|	ВЫБОР
	|		КОГДА П.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|
	|ИМЕЮЩИЕ
	|	(СУММА(П.Количество) <> 0
	|		ИЛИ СУММА(П.Стоимость) <> 0
	|		ИЛИ СУММА(П.СтоимостьБезСкидок) <> 0
	|		ИЛИ СУММА(П.ор_Себестоимость) <> 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	date,
	|	store_code,
	|	product_code,
	|	warehouse_guid,
	|	seller_guid,
	|	online";

	Запрос.УстановитьПараметр("Начало", Период.Начало);
	Запрос.УстановитьПараметр("Конец", Период.Конец);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвраты на кассе: строки пробитых и архивных чеков возврата ККМ.
Функция ВозвратыПоЧекам(Период)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК date,
	|	Т.Ссылка.Магазин КАК store_guid,
	|	Т.Ссылка.Магазин.Код КАК store_code,
	|	Т.Склад КАК warehouse_guid,
	|	Т.Номенклатура КАК product_guid,
	|	Т.Номенклатура.Код КАК product_code,
	|	ВЫБОР
	|		КОГДА Т.Продавец = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|			ТОГДА Т.Ссылка.Продавец
	|		ИНАЧЕ Т.Продавец
	|	КОНЕЦ КАК seller_guid,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТСтроки
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|	И НЕ Т.Ссылка.ПометкаУдаления
	|	И Т.Ссылка.СтатусЧекаККМ В (ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробитый), ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Архивный))
	|	И Т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	С.date КАК date,
	|	С.store_guid КАК store_guid,
	|	С.store_code КАК store_code,
	|	С.warehouse_guid КАК warehouse_guid,
	|	С.product_guid КАК product_guid,
	|	С.product_code КАК product_code,
	|	С.seller_guid КАК seller_guid,
	|	С.seller_guid.Наименование КАК seller_name,
	|	СУММА(С.Количество) КАК qty,
	|	СУММА(С.Сумма) КАК sum,
	|	0 КАК cost
	|ИЗ
	|	ВТСтроки КАК С
	|
	|СГРУППИРОВАТЬ ПО
	|	С.date,
	|	С.store_guid,
	|	С.store_code,
	|	С.warehouse_guid,
	|	С.product_guid,
	|	С.product_code,
	|	С.seller_guid,
	|	С.seller_guid.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	date,
	|	store_code,
	|	product_code,
	|	warehouse_guid,
	|	seller_guid";

	Запрос.УстановитьПараметр("Начало", Период.Начало);
	Запрос.УстановитьПараметр("Конец", Период.Конец);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Чеки ККМ по дням и часам, магазинам и продавцам.
Функция Чеки(Параметры)

	Период = ПериодИзПараметров(Параметры, 31);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ч.Ссылка КАК Ссылка,
	|	Ч.Дата КАК Дата,
	|	Ч.Магазин КАК Магазин,
	|	Ч.Продавец КАК Продавец,
	|	Ч.ВидОперации КАК ВидОперации,
	|	Ч.СуммаДокумента КАК СуммаДокумента
	|ПОМЕСТИТЬ ВТЧеки
	|ИЗ
	|	Документ.ЧекККМ КАК Ч
	|ГДЕ
	|	Ч.Дата МЕЖДУ &Начало И &Конец
	|	И НЕ Ч.ПометкаУдаления
	|	И Ч.СтатусЧекаККМ В (ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробитый), ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Архивный))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Ссылка КАК Ссылка,
	|	СУММА(О.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТСертификатыОплата
	|ИЗ
	|	Документ.ЧекККМ.Оплата КАК О
	|ГДЕ
	|	О.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТЧеки.Ссылка
	|			ИЗ
	|				ВТЧеки)
	|	И О.ВидОплаты.ТипОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыОплатЧекаККМ.ПодарочныйСертификат)
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ПОМЕСТИТЬ ВТСертификатыПогашение
	|ИЗ
	|	Документ.ЧекККМ.ПогашениеПодарочныхСертификатов КАК П
	|ГДЕ
	|	П.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТЧеки.Ссылка
	|			ИЗ
	|				ВТЧеки)
	|
	|СГРУППИРОВАТЬ ПО
	|	П.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Ч.Дата, ДЕНЬ) КАК date,
	|	ЧАС(Ч.Дата) КАК hour,
	|	Ч.Магазин КАК store_guid,
	|	Ч.Магазин.Код КАК store_code,
	|	Ч.Продавец КАК seller_guid,
	|	Ч.Продавец.Наименование КАК seller_name,
	|	СУММА(ВЫБОР
	|			КОГДА Ч.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК sale_checks,
	|	СУММА(ВЫБОР
	|			КОГДА Ч.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК return_checks,
	|	СУММА(ВЫБОР
	|			КОГДА Ч.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
	|				ТОГДА Ч.СуммаДокумента
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК sales_sum,
	|	СУММА(ВЫБОР
	|			КОГДА Ч.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|				ТОГДА Ч.СуммаДокумента
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК returns_sum,
	|	СУММА(ВЫБОР
	|			КОГДА Ч.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
	|				ТОГДА ЕСТЬNULL(СО.Сумма, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК certificate_payment_sum,
	|	СУММА(ЕСТЬNULL(СП.Количество, 0)) КАК certificates_redeemed
	|ИЗ
	|	ВТЧеки КАК Ч
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСертификатыОплата КАК СО
	|		ПО Ч.Ссылка = СО.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСертификатыПогашение КАК СП
	|		ПО Ч.Ссылка = СП.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Ч.Дата, ДЕНЬ),
	|	ЧАС(Ч.Дата),
	|	Ч.Магазин,
	|	Ч.Магазин.Код,
	|	Ч.Продавец,
	|	Ч.Продавец.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	date,
	|	hour,
	|	store_code,
	|	store_guid,
	|	seller_guid";

	Запрос.УстановитьПараметр("Начало", Период.Начало);
	Запрос.УстановитьПараметр("Конец", Период.Конец);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Остатки по складам и товарам на конец указанной даты (по умолчанию — текущие).
Функция Остатки(Параметры)

	ДатаСтрокой = Параметры.Получить("date");
	Если ЗначениеЗаполнено(ДатаСтрокой) Тогда
		Граница = Новый Граница(КонецДня(ДатаИзСтроки(ДатаСтрокой, "date")), ВидГраницы.Включая);
	Иначе
		Граница = Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.Склад КАК warehouse_guid,
	|	О.Склад.Код КАК warehouse_code,
	|	О.Номенклатура КАК product_guid,
	|	О.Номенклатура.Код КАК product_code,
	|	СУММА(О.КоличествоОстаток) КАК qty,
	|	СУММА(О.РезервОстаток) КАК reserve,
	|	СУММА(О.ор_СебестоимостьОстаток) КАК cost
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Граница, ) КАК О
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Склад,
	|	О.Склад.Код,
	|	О.Номенклатура,
	|	О.Номенклатура.Код
	|
	|ИМЕЮЩИЕ
	|	(СУММА(О.КоличествоОстаток) <> 0
	|		ИЛИ СУММА(О.РезервОстаток) <> 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	warehouse_code,
	|	warehouse_guid,
	|	product_code,
