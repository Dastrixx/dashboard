#Область Ответ

Функция МаксимумСтрок()
	Возврат 5000;
КонецФункции

// Отдаёт порцию таблицы: {"data": [...], "total": N, "limit": L, "offset": O}.
Функция ОтветТаблицей(Таблица, Параметры)

	Лимит = ЧислоИзПараметра(Параметры, "limit", МаксимумСтрок(), 1, МаксимумСтрок());
	Смещение = ЧислоИзПараметра(Параметры, "offset", 0, 0, 1000000000);
	Всего = Таблица.Количество();
	Последний = Мин(Всего, Смещение + Лимит) - 1;

	Колонки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("data");
	Запись.ЗаписатьНачалоМассива();

	Для Индекс = Смещение По Последний Цикл
		Строка = Таблица[Индекс];
		Запись.ЗаписатьНачалоОбъекта();
		Для Каждого Имя Из Колонки Цикл
			Запись.ЗаписатьИмяСвойства(Имя);
			ЗаписатьЗначение(Запись, Строка[Имя]);
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;

	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьИмяСвойства("total");
	Запись.ЗаписатьЗначение(Всего);
	Запись.ЗаписатьИмяСвойства("limit");
	Запись.ЗаписатьЗначение(Лимит);
	Запись.ЗаписатьИмяСвойства("offset");
	Запись.ЗаписатьЗначение(Смещение);
	Запись.ЗаписатьКонецОбъекта();

	Возврат ОтветСТелом(200, Запись.Закрыть());

КонецФункции

// Даты — "ГГГГ-ММ-ДД" (без времени) или ISO, ссылки — GUID,
// пустые ссылки и NULL — null, перечисления — имя значения.
Процедура ЗаписатьЗначение(Запись, Значение)

	Тип = ТипЗнч(Значение);

	Если Значение = Null Или Значение = Неопределено Тогда
		Запись.ЗаписатьЗначение(Неопределено);
	ИначеЕсли Тип = Тип("Число") Или Тип = Тип("Булево") Тогда
		Запись.ЗаписатьЗначение(Значение);
	ИначеЕсли Тип = Тип("Строка") Тогда
		Запись.ЗаписатьЗначение(СокрП(Значение));
	ИначеЕсли Тип = Тип("Дата") Тогда
		Если Значение = НачалоДня(Значение) Тогда
			Запись.ЗаписатьЗначение(Формат(Значение, "ДФ=yyyy-MM-dd"));
		Иначе
			Запись.ЗаписатьЗначение(ФорматДатаВремя(Значение));
		КонецЕсли;
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Если Значение.Пустая() Тогда
			Запись.ЗаписатьЗначение(Неопределено);
		Иначе
			Объект = Метаданные.НайтиПоТипу(Тип);
			Индекс = Перечисления[Объект.Имя].Индекс(Значение);
			Запись.ЗаписатьЗначение(Объект.ЗначенияПеречисления[Индекс].Имя);
		КонецЕсли;
	ИначеЕсли Метаданные.НайтиПоТипу(Тип) <> Неопределено Тогда
		Если Значение.Пустая() Тогда
			Запись.ЗаписатьЗначение(Неопределено);
		Иначе
			Запись.ЗаписатьЗначение(Строка(Значение.УникальныйИдентификатор()));
		КонецЕсли;
	Иначе
		Запись.ЗаписатьЗначение(Строка(Значение));
	КонецЕсли;

КонецПроцедуры

Функция ФорматДатаВремя(Значение)
	Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
КонецФункции

Функция ОтветJSON(Код, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Возврат ОтветСТелом(Код, Запись.Закрыть());
КонецФункции

Функция ОтветОшибка(Код, Текст)
	Возврат ОтветJSON(Код, Новый Структура("error", Текст));
КонецФункции

Функция ОтветСТелом(Код, Тело)
	Возврат Новый Структура("Код, Тело", Код, Тело);
КонецФункции

#КонецОбласти
