// Модуль HTTP-сервиса «ДашбордAPI» (корневой URL: dashboard).
//
// Шаблоны URL и обработчики (настраиваются в конфигураторе, см. onec/README.md):
//   /v1/ping    GET -> ПингGET
//   /v1/stock   GET -> ОстаткиGET
//
// Параметры /v1/stock (все необязательные, формат дат ГГГГ-ММ-ДД):
//   date  - остатки на конец указанного дня (по умолчанию - на текущий момент)
//   from, to - период для поступлений, списаний и пересчётов (включительно).
//              Без периода отдаются последние документы (60 / 30 / 30 штук).

#Область ОбработчикиЗапросов

Функция ПингGET(Запрос)

	Результат = Новый Структура;
	Результат.Вставить("status", "ok");
	Результат.Вставить("generatedAt", ДатаВСтроку(ТекущаяДатаСеанса()));

	Возврат ОтветJSON(200, Результат);

КонецФункции

Функция ОстаткиGET(Запрос)

	// Сервис только читает данные. Привилегированный режим нужен, чтобы
	// пользователю сервиса не требовались права на объекты основной конфигурации
	// (в расширении роль не может выдать права на незаимствованные объекты).
	УстановитьПривилегированныйРежим(Истина);

	Попытка

		НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Параметры = Запрос.ПараметрыЗапроса;

		ДатаОстатковСтрока = Параметры.Получить("date");
		ПериодССтрока = Параметры.Получить("from");
		ПериодПоСтрока = Параметры.Получить("to");

		ДатаОстатков = РазобратьДату(ДатаОстатковСтрока, Истина);
		Начало = РазобратьДату(ПериодССтрока, Ложь);
		Конец = РазобратьДату(ПериодПоСтрока, Истина);

		Если (ЗначениеЗаполнено(ДатаОстатковСтрока) И ДатаОстатков = Неопределено)
			Или (ЗначениеЗаполнено(ПериодССтрока) И Начало = Неопределено)
			Или (ЗначениеЗаполнено(ПериодПоСтрока) И Конец = Неопределено) Тогда
			Возврат ОтветОшибка(400, "Даты передаются в формате ГГГГ-ММ-ДД");
		КонецЕсли;

		ЕстьПериод = (Начало <> Неопределено) Или (Конец <> Неопределено);
		Если Начало = Неопределено Тогда
			Начало = Дата(1, 1, 1);
		КонецЕсли;
		Если Конец = Неопределено Тогда
			Конец = Дата(3999, 12, 31, 23, 59, 59);
		КонецЕсли;

		Товары = Новый Соответствие;
		Склады = ЗагрузитьСклады();
		Остатки = ЗагрузитьОстатки(ДатаОстатков, Товары);
		Поступления = ЗагрузитьПоступления(Начало, Конец, ЕстьПериод);
		Списания = ЗагрузитьСписания(Начало, Конец, ЕстьПериод, Товары);
		Пересчеты = ЗагрузитьПересчеты(Начало, Конец, ЕстьПериод, Товары);

		Результат = Новый Структура;
		Результат.Вставить("items", Остатки);
		Результат.Вставить("products", МассивЗначений(Товары));
		Результат.Вставить("warehouses", Склады);
		Результат.Вставить("categories", СписокКатегорий());
		Результат.Вставить("receipts", Поступления);
		Результат.Вставить("writeOffs", Списания);
		Результат.Вставить("recounts", Пересчеты);

		Мета = Новый Структура;
		Мета.Вставить("generatedAt", ДатаВСтроку(ТекущаяДатаСеанса()));
		Мета.Вставить("asOf", ?(ДатаОстатков = Неопределено, ДатаВСтроку(ТекущаяДатаСеанса()), ДатаВСтроку(ДатаОстатков)));
		Мета.Вставить("periodFrom", ?(ЕстьПериод, ДатаВСтроку(Начало), Неопределено));
		Мета.Вставить("periodTo", ?(ЕстьПериод, ДатаВСтроку(Конец), Неопределено));
		Мета.Вставить("documentsLimited", Не ЕстьПериод);
		Мета.Вставить("rows", Остатки.Количество());
		Мета.Вставить("durationMs", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера);
		Результат.Вставить("meta", Мета);

		Возврат ОтветJSON(200, Результат);

	Исключение
		Возврат ОтветОшибка(500, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Загрузка

// Остатки по связке товар x склад. Данные о товарах складываются в Товары.
Функция ЗагрузитьОстатки(ДатаОстатков, Товары)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Склад КАК Склад,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Количество,
	|	ЕСТЬNULL(Остатки.РезервОстаток, 0) КАК Резерв,
	|" + ПоляТовара("П") + "
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Граница, ) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК П
	|		ПО Остатки.Номенклатура = П.Ссылка
	|ГДЕ
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) <> 0
	|	ИЛИ ЕСТЬNULL(Остатки.РезервОстаток, 0) <> 0";

	// Неопределено = на текущий момент.
	Запрос.УстановитьПараметр("Граница", ДатаОстатков);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьТовар(Товары, Выборка);
		Элемент = Новый Структура;
		Элемент.Вставить("productKey", КлючСсылки(Выборка.ТоварСсылка));
		Элемент.Вставить("warehouseKey", КлючСсылки(Выборка.Склад));
		Элемент.Вставить("quantity", Окр(Выборка.Количество, 3));
		Элемент.Вставить("reserved", Окр(Выборка.Резерв, 3));
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗагрузитьСклады()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Ссылка КАК Ссылка,
	|	С.Код КАК Код,
	|	С.Наименование КАК Наименование,
	|	С.ТипСклада КАК ТипСклада,
	|	С.Магазин КАК Магазин
	|ИЗ
	|	Справочник.Склады КАК С
	|ГДЕ
	|	НЕ С.ПометкаУдаления";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Склад = Новый Структура;
		Склад.Вставить("key", КлючСсылки(Выборка.Ссылка));
		Склад.Вставить("code", СокрЛП(Выборка.Код));
		Склад.Вставить("name", СокрЛП(Выборка.Наименование));
		Склад.Вставить("type", КлассТипаСклада(Выборка.ТипСклада));
		Склад.Вставить("typeName", ИмяЗначения(Выборка.ТипСклада));
		Склад.Вставить("storeKey", КлючСсылки(Выборка.Магазин));
		Результат.Добавить(Склад);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗагрузитьПоступления(Начало, Конец, ЕстьПериод)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ &Лимит
	|	Д.Ссылка КАК Документ,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Склад КАК Склад,
	|	ЕСТЬNULL(Д.Контрагент.НаименованиеПолное, """") КАК ПоставщикПолное,
	|	ЕСТЬNULL(Д.Контрагент.Наименование, """") КАК Поставщик,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Номенклатура) КАК КоличествоSKU,
	|	ЕСТЬNULL(СУММА(Т.Количество), 0) КАК Единиц
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК Д
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров.Товары КАК Т
	|		ПО Д.Ссылка = Т.Ссылка
	|ГДЕ
	|	Д.Проведен
	|	И Д.Дата МЕЖДУ &Начало И &Конец
	|СГРУППИРОВАТЬ ПО
	|	Д.Ссылка,
	|	Д.Номер,
	|	Д.Дата,
	|	Д.Склад,
	|	Д.Контрагент
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата УБЫВ";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Лимит", ЛимитТекстом(60, ЕстьПериод));
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Поставщик = СокрЛП(Выборка.ПоставщикПолное);
		Если Поставщик = "" Тогда
			Поставщик = СокрЛП(Выборка.Поставщик);
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("key", КлючСсылки(Выборка.Документ));
		Элемент.Вставить("number", СокрЛП(Выборка.Номер));
		Элемент.Вставить("date", ДатаВСтроку(Выборка.Дата));
		Элемент.Вставить("warehouseKey", КлючСсылки(Выборка.Склад));
		Элемент.Вставить("supplier", Поставщик);
		Элемент.Вставить("skuCount", Выборка.КоличествоSKU);
		Элемент.Вставить("units", Окр(Выборка.Единиц, 3));
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗагрузитьСписания(Начало, Конец, ЕстьПериод, Товары)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ &Лимит
	|	Д.Ссылка КАК Документ,
	|	Д.Дата КАК Дата,
	|	Д.Склад КАК Склад,
	|	Д.ОснованиеСписания КАК Основание,
	|	Д.Комментарий КАК Комментарий
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.СписаниеТоваров КАК Д
	|ГДЕ
	|	Д.Проведен
	|	И Д.Дата МЕЖДУ &Начало И &Конец
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата УБЫВ
	|;
	|
	|ВЫБРАТЬ
	|	Д.Документ КАК Документ,
	|	Д.Дата КАК Дата,
	|	Д.Склад КАК Склад,
	|	Д.Основание КАК Основание,
	|	Д.Комментарий КАК Комментарий,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Количество КАК Количество,
	|" + ПоляТовара("П") + "
	|ИЗ
	|	ВТ_Документы КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеТоваров.Товары КАК Т
	|		ПО Д.Документ = Т.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК П
	|		ПО Т.Номенклатура = П.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата УБЫВ,
	|	Д.Документ,
	|	Т.НомерСтроки";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Лимит", ЛимитТекстом(30, ЕстьПериод));
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьТовар(Товары, Выборка);
		Причина = СокрЛП(Строка(Выборка.Основание));
		Если Причина = "" Тогда
			Причина = СокрЛП(Строка(Выборка.Комментарий));
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("key", КлючСсылки(Выборка.Документ));
		Элемент.Вставить("line", Выборка.НомерСтроки);
		Элемент.Вставить("date", ДатаВСтроку(Выборка.Дата));
		Элемент.Вставить("warehouseKey", КлючСсылки(Выборка.Склад));
		Элемент.Вставить("productKey", КлючСсылки(Выборка.ТоварСсылка));
		Элемент.Вставить("quantity", Окр(Выборка.Количество, 3));
		Элемент.Вставить("reason", Причина);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

