	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ &Лимит
	|	Д.Ссылка КАК Документ,
	|	Д.Дата КАК Дата,
	|	Д.Склад КАК Склад
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.ПересчетТоваров КАК Д
	|ГДЕ
	|	Д.Проведен
	|	И Д.Дата МЕЖДУ &Начало И &Конец
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата УБЫВ
	|;
	|
	|ВЫБРАТЬ
	|	Д.Документ КАК Документ,
	|	Д.Дата КАК Дата,
	|	Д.Склад КАК Склад,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Количество КАК Количество,
	|	Т.КоличествоФакт КАК КоличествоФакт,
	|" + ПоляТовара("П") + "
	|ИЗ
	|	ВТ_Документы КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПересчетТоваров.Товары КАК Т
	|		ПО Д.Документ = Т.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК П
	|		ПО Т.Номенклатура = П.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата УБЫВ,
	|	Д.Документ,
	|	Т.НомерСтроки";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Лимит", ЛимитТекстом(30, ЕстьПериод));
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьТовар(Товары, Выборка);
		Элемент = Новый Структура;
		Элемент.Вставить("key", КлючСсылки(Выборка.Документ));
		Элемент.Вставить("line", Выборка.НомерСтроки);
		Элемент.Вставить("date", ДатаВСтроку(Выборка.Дата));
		Элемент.Вставить("warehouseKey", КлючСсылки(Выборка.Склад));
		Элемент.Вставить("productKey", КлючСсылки(Выборка.ТоварСсылка));
		Элемент.Вставить("accounting", Окр(Выборка.Количество, 3));
		Элемент.Вставить("actual", Окр(Выборка.КоличествоФакт, 3));
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Товары

// Общий кусок запроса: поля товара (алиас таблицы номенклатуры передаётся параметром).
// Подгруппа - прямой родитель товара, группа - родитель подгруппы (уточнить по структуре базы).
Функция ПоляТовара(Алиас)

	Возврат
	"	" + Алиас + ".Ссылка КАК ТоварСсылка,
	|	" + Алиас + ".Артикул КАК Артикул,
	|	" + Алиас + ".Код КАК ТоварКод,
	|	" + Алиас + ".Наименование КАК ТоварНаименование,
	|	" + Алиас + ".НаименованиеПолное КАК ТоварПолноеНаименование,
	|	ЕСТЬNULL(" + Алиас + ".ВидНоменклатуры.Наименование, """") КАК ВидНоменклатуры,
	|	" + Алиас + ".Родитель КАК ПодгруппаСсылка,
	|	ЕСТЬNULL(" + Алиас + ".Родитель.Наименование, """") КАК Подгруппа,
	|	ЕСТЬNULL(" + Алиас + ".Родитель.Родитель.Наименование, """") КАК Группа";

КонецФункции

Процедура ДобавитьТовар(Товары, Выборка)

	Ключ = КлючСсылки(Выборка.ТоварСсылка);
	Если Ключ = "" Или Товары.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Название = СокрЛП(Выборка.ТоварПолноеНаименование);
	Если Название = "" Тогда
		Название = СокрЛП(Выборка.ТоварНаименование);
	КонецЕсли;
	Артикул = СокрЛП(Выборка.Артикул);
	Если Артикул = "" Тогда
		Артикул = СокрЛП(Выборка.ТоварКод);
	КонецЕсли;

	Категория = КатегорияПоВиду(Выборка.ВидНоменклатуры);

	Товар = Новый Структура;
	Товар.Вставить("key", Ключ);
	Товар.Вставить("sku", Артикул);
	Товар.Вставить("name", Название);
	Товар.Вставить("kind", СокрЛП(Выборка.ВидНоменклатуры));
	Товар.Вставить("categoryKey", ?(Категория = Неопределено, "", Категория.key));
	Товар.Вставить("category", ?(Категория = Неопределено, "", Категория.name));
	Товар.Вставить("group", СокрЛП(Выборка.Группа));
	Товар.Вставить("subgroupKey", КлючСсылки(Выборка.ПодгруппаСсылка));
	Товар.Вставить("subgroup", СокрЛП(Выборка.Подгруппа));
	Товары.Вставить(Ключ, Товар);

КонецПроцедуры

// Бизнес-категории определяются по названию вида номенклатуры.
// Список перенесён из дашборда (server/dashboard/constants.mjs).
Функция СписокКатегорий()

	Результат = Новый Массив;
	Результат.Добавить(НоваяКатегория("home-textile", "Домашний текстиль", "домашний текстиль;плед"));
	Результат.Добавить(НоваяКатегория("tableware", "Посуда", "посуда;посуда китай"));
	Результат.Добавить(НоваяКатегория("clothing", "Одежда", "одежда"));
	Результат.Добавить(НоваяКатегория("household-chemicals", "Бытовая химия", "детская химия;мыломойка;бытовая химия"));
	Возврат Результат;

КонецФункции

Функция НоваяКатегория(Ключ, Название, Алиасы)

	Категория = Новый Структура;
	Категория.Вставить("key", Ключ);
	Категория.Вставить("name", Название);
	Категория.Вставить("aliases", Алиасы);
	Возврат Категория;

КонецФункции

Функция КатегорияПоВиду(НазваниеВида)

	Имя = НормализоватьИмя(НазваниеВида);
	Если Имя = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Категория Из СписокКатегорий() Цикл
		Для Каждого Алиас Из СтрРазделить(Категория.aliases, ";") Цикл
			Если Имя = Алиас Тогда
				Возврат Категория;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область Служебные

Функция ЛимитТекстом(ПоУмолчанию, ЕстьПериод)

	// Страховка от выгрузки всей базы, если период задан слишком широким.
	Возврат Формат(?(ЕстьПериод, 2000, ПоУмолчанию), "ЧГ=0");

КонецФункции

Функция РазобратьДату(Знач Значение, КонецДня)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Части = СтрРазделить(Значение, "-");
	Если Части.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Год = Число(Части[0]);
		Месяц = Число(Части[1]);
		День = Число(Части[2]);
		Если КонецДня Тогда
			Возврат Дата(Год, Месяц, День, 23, 59, 59);
		КонецЕсли;
		Возврат Дата(Год, Месяц, День);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ДатаВСтроку(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Локальное время базы без смещения часового пояса.
	Возврат Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss");

КонецФункции

Функция КлючСсылки(Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Ссылка.УникальныйИдентификатор());

КонецФункции

Функция МассивЗначений(Соответствие)

	Результат = Новый Массив;
	Для Каждого Элемент Из Соответствие Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НормализоватьИмя(Значение)

	Результат = НРег(СокрЛП(Строка(Значение)));
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имя значения реквизита «ТипСклада» (перечисление или строка).
Функция ИмяЗначения(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
		Попытка
			ПолноеИмя = ПолучитьПолноеИмяПредопределенногоЗначения(Значение);
			Возврат Сред(ПолноеИмя, СтрНайти(ПолноеИмя, ".", НаправлениеПоиска.СКонца) + 1);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// store - торговый зал, warehouse - складское помещение, остальное - other.
Функция КлассТипаСклада(Значение)

	Имя = НормализоватьИмя(СтрЗаменить(ИмяЗначения(Значение), " ", ""));

	Если Имя = "торговыйзал" Тогда
		Возврат "store";
	ИначеЕсли Имя = "складскоепомещение" Тогда
		Возврат "warehouse";
	КонецЕсли;

	Возврат "other";

КонецФункции

Функция ОтветJSON(КодОтвета, Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Текст = Запись.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

Функция ОтветОшибка(КодОтвета, Сообщение)

	Возврат ОтветJSON(КодОтвета, Новый Структура("message", Сообщение));

КонецФункции

